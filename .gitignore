# Luandro NRP — .gitignore

# Build outputs
build/
.cxx/
.gradle/
local.properties
*.iml
.idea/
.DS_Store

# Generated code (do NOT commit — regenerated by Binding Generator)
generated/

# Android
*.apk
*.aar
*.ap_

# Native build artifacts
*.so
*.a
*.o
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Thirdparty (managed as Git Submodules)
# thirdparty/*/   ← tracked as submodules, not ignored

# Kotlin / Java
*.class
